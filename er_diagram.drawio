        <mxCell id="edge_bom_mat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=1.5;endArrow=none;" edge="1" source="sub_materials" target="rel_bom" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

