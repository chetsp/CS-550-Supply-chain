  <diagram id="cs550_eer_diagram" name="CS550 Supply Chain EER">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" background="#f8fafc" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Banner -->
        <mxCell id="title" value="&lt;b style='font-size:18px;'&gt;CS 550 / CS 450: Collaborative Supply Chain EER Diagram&lt;/b&gt;&lt;br&gt;&lt;span style='color:#64748b;font-size:12px;'&gt;Conceptual Extended Entity-Relationship Model (Specialization Hierarchies, Associative Pricing, Independent Orders)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;align=left;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1560" height="60" as="geometry" />
        </mxCell>

        <!-- ==================== HIERARCHY 1: BUSINESS ENTITIES ==================== -->
        <!-- Superclass: BusinessEntities -->
        <mxCell id="be_super" value="&lt;b style='font-size:14px;color:#ffffff;'&gt;BusinessEntities (Superclass)&lt;/b&gt;&lt;hr style='border:0;border-top:1px solid #93c5fd;'&gt;&lt;b&gt;&lt;u&gt;entityId&lt;/u&gt;&lt;/b&gt; : VARCHAR(30) [PK]&lt;br&gt;name : VARCHAR(100)&lt;br&gt;shipLoc : VARCHAR(50)&lt;br&gt;address : VARCHAR(150)&lt;br&gt;phone : VARCHAR(20)&lt;br&gt;web : VARCHAR(100)&lt;br&gt;contactInfo : VARCHAR(100)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563eb;strokeColor=#1d4ed8;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="280" height="180" as="geometry" />
        </mxCell>

        <!-- ISA Circle (d: Disjoint) -->
        <mxCell id="be_isa" value="&lt;b style='font-size:14px;color:#1d4ed8;'&gt;d&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="345" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- Line: BE Superclass to ISA -->
        <mxCell id="edge_be_isa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=none;" edge="1" source="be_super" target="be_isa" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Subclass: Suppliers -->
        <mxCell id="sub_suppliers" value="&lt;b style='font-size:13px;color:#1e40af;'&gt;Suppliers (Subclass)&lt;/b&gt;&lt;hr style='border:0;border-top:1px solid #bfdbfe;'&gt;&lt;b&gt;&lt;u&gt;supplierId&lt;/u&gt;&lt;/b&gt; [PK, FK &amp;rarr; BE]&lt;br&gt;discountThreshold1 : NUMBER&lt;br&gt;discountPercent1 : NUMBER&lt;br&gt;discountThreshold2 : NUMBER&lt;br&gt;discountPercent2 : NUMBER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e293b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="420" width="210" height="130" as="geometry" />
        </mxCell>

        <!-- Subclass: Manufacturers -->
        <mxCell id="sub_manufs" value="&lt;b style='font-size:13px;color:#1e40af;'&gt;Manufacturers (Subclass)&lt;/b&gt;&lt;hr style='border:0;border-top:1px solid #bfdbfe;'&gt;&lt;b&gt;&lt;u&gt;manufId&lt;/u&gt;&lt;/b&gt; [PK, FK &amp;rarr; BE]&lt;br&gt;discountThreshold : NUMBER&lt;br&gt;discountPercent : NUMBER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e293b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="420" width="210" height="100" as="geometry" />
        </mxCell>

        <!-- Subclass: Customers -->
        <mxCell id="sub_customers" value="&lt;b style='font-size:13px;color:#1e40af;'&gt;Customers (Subclass)&lt;/b&gt;&lt;hr style='border:0;border-top:1px solid #bfdbfe;'&gt;&lt;b&gt;&lt;u&gt;customerId&lt;/u&gt;&lt;/b&gt; [PK, FK &amp;rarr; BE]&lt;br&gt;customerType : VARCHAR&lt;br&gt;creditLimit : NUMBER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#1e293b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="580" width="210" height="100" as="geometry" />
        </mxCell>

        <!-- Subclass: Shippers -->
