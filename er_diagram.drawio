        </mxCell>

        <!-- SupplyOrders -->
        <mxCell id="ord_sup" value="&lt;b style='color:#ffffff;'&gt;SupplyOrders&lt;/b&gt;&lt;hr&gt;&lt;b&gt;&lt;u&gt;orderId&lt;/u&gt;&lt;/b&gt; : VARCHAR(30) [PK]&lt;br&gt;supplierId : VARCHAR(30) [FK &amp;rarr; Suppliers]&lt;br&gt;itemId : VARCHAR(30) [FK &amp;rarr; Items]&lt;br&gt;orderedQty : NUMBER &gt; 0&lt;br&gt;orderDate : DATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=#0369a1;strokeWidth=2;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
