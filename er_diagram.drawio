        <mxCell id="edge_isa_man" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3b82f6;strokeWidth=1.5;endArrow=classic;" edge="1" source="be_isa" target="sub_manufs" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_isa_cus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3b82f6;strokeWidth=1.5;endArrow=classic;" edge="1" source="be_isa" target="sub_customers" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_isa_shp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3b82f6;strokeWidth=1.5;endArrow=classic;" edge="1" source="be_isa" target="sub_shippers" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ==================== HIERARCHY 2: ITEMS ==================== -->
