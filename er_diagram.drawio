        <mxCell id="edge_isa_mat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;endArrow=classic;" edge="1" source="item_isa" target="sub_materials" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_isa_prod" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;endArrow=classic;" edge="1" source="item_isa" target="sub_products" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ==================== RELATIONSHIPS & ASSOCIATIVE PRICING ==================== -->
