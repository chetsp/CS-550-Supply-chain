        <!-- Subclass: MaterialItems -->
        <mxCell id="sub_materials" value="&lt;b style='font-size:13px;color:#065f46;'&gt;MaterialItems (Subclass)&lt;/b&gt;&lt;hr style='border:0;border-top:1px solid #a7f3d0;'&gt;&lt;b&gt;&lt;u&gt;itemId&lt;/u&gt;&lt;/b&gt; [PK, FK &amp;rarr; Items]&lt;br&gt;materialType : VARCHAR(50)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10b981;strokeWidth=1.5;fontColor=#1e293b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1110" y="370" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Subclass: ProductItems -->
        <mxCell id="sub_products" value="&lt;b style='font-size:13px;color:#065f46;'&gt;ProductItems (Subclass)&lt;/b&gt;&lt;hr style='border:0;border-top:1px solid #a7f3d0;'&gt;&lt;b&gt;&lt;u&gt;itemId&lt;/u&gt;&lt;/b&gt; [PK, FK &amp;rarr; Items]&lt;br&gt;productLine : VARCHAR(50)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10b981;strokeWidth=1.5;fontColor=#1e293b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1350" y="370" width="200" height="80" as="geometry" />
