        <mxCell id="e_mp_man" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8b5cf6;strokeWidth=1.5;strokeDasharray=4;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="sub_man" target="mp_price" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_mp_prd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8b5cf6;strokeWidth=1.5;strokeDasharray=4;endArrow=none;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="sub_prd" target="mp_price" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Shipping Pricing -->
        <mxCell id="shp_price" value="&lt;b style='color:#5b21b6;'&gt;ShippingPricing (Route Schedule)&lt;/b&gt;&lt;hr&gt;&lt;b&gt;&lt;u&gt;shipperId&lt;/u&gt;&lt;/b&gt; [FK], &lt;b&gt;&lt;u&gt;fromLoc&lt;/u&gt;&lt;/b&gt;, &lt;b&gt;&lt;u&gt;toLoc&lt;/u&gt;&lt;/b&gt;&lt;br&gt;minPackagePrice, pricePerLb&lt;br&gt;discountThreshold1, discountPercent1&lt;br&gt;discountThreshold2, discountPercent2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="335" width="260" height="105" as="geometry" />
