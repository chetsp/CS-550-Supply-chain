          <mxGeometry x="240" y="475" width="180" height="75" as="geometry" />
        </mxCell>

        <!-- ISA Edges -->
        <mxCell id="e_isa_sup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3b82f6;strokeWidth=1.5;endArrow=classic;entryX=0.5;entryY=0;" edge="1" source="be_isa" target="sub_sup" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_isa_man" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3b82f6;strokeWidth=1.5;endArrow=classic;entryX=0.5;entryY=0;" edge="1" source="be_isa" target="sub_man" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_isa_cus" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3b82f6;strokeWidth=1.5;endArrow=classic;entryX=0.5;entryY=0;" edge="1" source="be_isa" target="sub_cus" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_isa_shp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3b82f6;strokeWidth=1.5;endArrow=classic;entryX=0.5;entryY=0;" edge="1" source="be_isa" target="sub_shp" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>


        <!-- ==================== 2. ITEMS HIERARCHY & BOM (RIGHT) ==================== -->
        <!-- Superclass: Items -->
        <mxCell id="items" value="&lt;b style='font-size:13px;'&gt;Items&lt;/b&gt;&lt;hr&gt;&lt;b&gt;&lt;u&gt;itemId&lt;/u&gt;&lt;/b&gt; : VARCHAR(30) [PK]&lt;br&gt;itemName : VARCHAR(100)&lt;br&gt;unitWeight : NUMBER &gt; 0&lt;br&gt;itemCategory : VARCHAR(20)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="100" width="240" height="110" as="geometry" />
        </mxCell>

        <!-- Overlapping ISA Circle 'o' -->
        <mxCell id="item_isa" value="&lt;b style='font-size:13px;color:#047857;'&gt;o&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;align=center;" vertex="1" parent="1">
