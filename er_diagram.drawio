        <mxCell id="edge_item_price" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8b5cf6;strokeWidth=1.5;strokeDasharray=4;endArrow=none;" edge="1" source="item_super" target="rel_supply_pricing" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Manufacturing Pricing -->
