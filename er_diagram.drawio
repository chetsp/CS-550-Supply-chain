        <mxCell id="rel_bom" value="&lt;b style='font-size:13px;color:#92400e;'&gt;BillOfMaterials (BOM)&lt;/b&gt;&lt;hr style='border:0;border-top:1px solid #fde68a;'&gt;&lt;b&gt;&lt;u&gt;prodItemId&lt;/u&gt;&lt;/b&gt; [FK &amp;rarr; ProductItems]&lt;br&gt;&lt;b&gt;&lt;u&gt;matItemId&lt;/u&gt;&lt;/b&gt; [FK &amp;rarr; MaterialItems]&lt;br&gt;qtyMatPerItem : NUMBER &gt; 0&lt;br&gt;&lt;i style='font-size:10px;color:#b45309;'&gt;CHECK(prodItemId &amp;lt;&amp;gt; matItemId)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontColor=#1e293b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
