          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Subclass: MaterialItems -->
        <mxCell id="sub_mat" value="&lt;b&gt;MaterialItems&lt;/b&gt;&lt;hr&gt;&lt;b&gt;&lt;u&gt;itemId&lt;/u&gt;&lt;/b&gt; [PK, FK]&lt;br&gt;materialType : VARCHAR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10b981;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="295" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Subclass: ProductItems -->
        <mxCell id="sub_prd" value="&lt;b&gt;ProductItems&lt;/b&gt;&lt;hr&gt;&lt;b&gt;&lt;u&gt;itemId&lt;/u&gt;&lt;/b&gt; [PK, FK]&lt;br&gt;productLine : VARCHAR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10b981;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1340" y="295" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e_isa_mat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=1.5;endArrow=classic;entryX=0.5;entryY=0;" edge="1" source="item_isa" target="sub_mat" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_isa_prd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=1.5;endArrow=classic;entryX=0.5;entryY=0;" edge="1" source="item_isa" target="sub_prd" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Bill Of Materials (BOM) -->
        <mxCell id="bom" value="&lt;b style='color:#92400e;'&gt;BillOfMaterials (M:N BOM)&lt;/b&gt;&lt;hr&gt;&lt;b&gt;&lt;u&gt;prodItemId&lt;/u&gt;&lt;/b&gt; [FK &amp;rarr; ProductItems]&lt;br&gt;&lt;b&gt;&lt;u&gt;matItemId&lt;/u&gt;&lt;/b&gt; [FK &amp;rarr; MaterialItems]&lt;br&gt;qtyMatPerItem : NUMBER &gt; 0&lt;br&gt;&lt;i style='font-size:10px;color:#b45309;'&gt;CHECK(prodItemId &amp;lt;&amp;gt; matItemId)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1200" y="410" width="240" height="95" as="geometry" />
        </mxCell>
        <mxCell id="e_bom_mat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=1.5;endArrow=none;entryX=0.3;entryY=0;" edge="1" source="sub_mat" target="bom" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_bom_prd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97706;strokeWidth=1.5;endArrow=none;entryX=0.7;entryY=0;" edge="1" source="sub_prd" target="bom" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>


        <!-- ==================== 3. PRICING & DEMAND (CENTER COLUMN) ==================== -->
        <!-- Supply Pricing -->
        <mxCell id="sp_price" value="&lt;b style='color:#5b21b6;'&gt;SupplyPricing&lt;/b&gt;&lt;hr&gt;&lt;b&gt;&lt;u&gt;supplierId&lt;/u&gt;&lt;/b&gt; [FK], &lt;b&gt;&lt;u&gt;itemId&lt;/u&gt;&lt;/b&gt; [FK]&lt;br&gt;pricePerUnit : NUMBER &gt; 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="110" width="260" height="70" as="geometry" />
        </mxCell>
        <!-- Connect Suppliers & Items to SupplyPricing -->
        <mxCell id="e_sp_sup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8b5cf6;strokeWidth=1.5;strokeDasharray=4;endArrow=none;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" source="sub_sup" target="sp_price" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_sp_itm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8b5cf6;strokeWidth=1.5;strokeDasharray=4;endArrow=none;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="items" target="sp_price" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Manufacturing Pricing -->
        <mxCell id="mp_price" value="&lt;b style='color:#5b21b6;'&gt;ManufacturingPricing&lt;/b&gt;&lt;hr&gt;&lt;b&gt;&lt;u&gt;manufId&lt;/u&gt;&lt;/b&gt; [FK], &lt;b&gt;&lt;u&gt;prodItemId&lt;/u&gt;&lt;/b&gt; [FK]&lt;br&gt;setUpCost : NUMBER &gt;= 0&lt;br&gt;prodCostPerUnit : NUMBER &gt; 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="215" width="260" height="85" as="geometry" />
