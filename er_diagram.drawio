          <mxGeometry x="240" y="335" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- Subclass: Customers -->
        <mxCell id="sub_cus" value="&lt;b&gt;Customers&lt;/b&gt;&lt;hr&gt;&lt;b&gt;&lt;u&gt;customerId&lt;/u&gt;&lt;/b&gt; [PK, FK]&lt;br&gt;customerType&lt;br&gt;creditLimit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
