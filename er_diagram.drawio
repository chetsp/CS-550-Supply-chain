        <mxCell id="edge_item_isa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;endArrow=none;" edge="1" source="item_super" target="item_isa" parent="1">
          <mxGeometry relative="1" as="geometry" />
