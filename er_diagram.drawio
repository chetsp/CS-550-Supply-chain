        <mxCell id="e_shp_price" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8b5cf6;strokeWidth=1.5;strokeDasharray=4;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="sub_shp" target="shp_price" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Customer Demand -->
        <mxCell id="cust_demand" value="&lt;b style='color:#9d174d;'&gt;CustomerDemand&lt;/b&gt;&lt;hr&gt;&lt;b&gt;&lt;u&gt;customerId&lt;/u&gt;&lt;/b&gt; [FK], &lt;b&gt;&lt;u&gt;itemId&lt;/u&gt;&lt;/b&gt; [FK]&lt;br&gt;demandQty : NUMBER &gt; 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#ec4899;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="475" width="260" height="75" as="geometry" />
        </mxCell>
        <mxCell id="e_cd_cus" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ec4899;strokeWidth=1.5;strokeDasharray=4;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="sub_cus" target="cust_demand" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_cd_itm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ec4899;strokeWidth=1.5;strokeDasharray=4;endArrow=none;exitX=0;exitY=0.8;entryX=1;entryY=0.5;" edge="1" source="items" target="cust_demand" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>


        <!-- ==================== 4. INDEPENDENT TRANSACTION ORDERS (BOTTOM) ==================== -->
        <mxCell id="orders_box" value="&lt;b style='font-size:14px;color:#0f172a;'&gt;Transaction Orders (Recorded Separately per Specification)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=16;spacingTop=8;" vertex="1" parent="1">
