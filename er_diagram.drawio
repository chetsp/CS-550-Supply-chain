          <mxGeometry x="165" y="275" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="edge_be_to_isa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=none;" edge="1" source="be" target="be_isa" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Subclass: Suppliers -->
