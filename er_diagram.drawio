        </mxCell>

        <!-- ManufacturingOrders -->
        <mxCell id="ord_man" value="&lt;b style='color:#ffffff;'&gt;ManufacturingOrders&lt;/b&gt;&lt;hr&gt;&lt;b&gt;&lt;u&gt;orderId&lt;/u&gt;&lt;/b&gt; : VARCHAR(30) [PK]&lt;br&gt;manufId : VARCHAR(30) [FK &amp;rarr; Manufacturers]&lt;br&gt;prodItemId : VARCHAR(30) [FK &amp;rarr; ProductItems]&lt;br&gt;orderedQty : NUMBER &gt; 0&lt;br&gt;orderDate : DATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d9488;strokeColor=#0f766e;strokeWidth=2;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="670" width="330" height="120" as="geometry" />
        </mxCell>

        <!-- ShippingOrders -->
        <mxCell id="ord_shp" value="&lt;b style='color:#ffffff;'&gt;ShippingOrders&lt;/b&gt;&lt;hr&gt;&lt;b&gt;&lt;u&gt;shipOrderId&lt;/u&gt;&lt;/b&gt; : VARCHAR(30) [PK]&lt;br&gt;shipperId : VARCHAR(30) [FK &amp;rarr; Shippers]&lt;br&gt;senderId : VARCHAR(30) [FK &amp;rarr; BusinessEntities]&lt;br&gt;recipientId : VARCHAR(30) [FK &amp;rarr; BusinessEntities]&lt;br&gt;itemId : VARCHAR(30) [FK &amp;rarr; Items]&lt;br&gt;shippedQty : NUMBER &gt; 0, shipDate : DATE&lt;br&gt;&lt;b style='color:#fee2e2;font-size:10px;'&gt;CHECK(senderId &amp;lt;&amp;gt; recipientId)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ea580c;strokeColor=#c2410c;strokeWidth=2;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="670" width="380" height="145" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;EER Notation Legend&lt;/b&gt;&lt;hr&gt;&lt;b style='color:#1d4ed8;'&gt;(d)&lt;/b&gt; Disjoint Subclasses (Cannot be both)&lt;br&gt;&lt;b style='color:#047857;'&gt;(o)&lt;/b&gt; Overlapping Subclasses (Can be both)&lt;br&gt;&lt;b&gt;&lt;u&gt;Underline&lt;/u&gt;&lt;/b&gt; : Primary Key (PK)&lt;br&gt;&lt;b&gt;[FK]&lt;/b&gt; : Foreign Key Constraint&lt;br&gt;&lt;span style='color:#8b5cf6;'&gt;&amp;bull;&amp;bull;&amp;bull;&amp;bull;&lt;/span&gt; Pricing Schedule Association&lt;br&gt;&lt;b style='color:#ea580c;'&gt;&amp;mdash;&amp;mdash;&lt;/b&gt; Transaction Order Entity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1230" y="670" width="300" height="145" as="geometry" />
        </mxCell>

        <!-- Connectors from Subclasses to Orders -->
        <mxCell id="e_ord_sup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0284c7;strokeWidth=1.5;endArrow=classic;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" source="sub_sup" target="ord_sup" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
