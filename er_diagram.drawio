  <diagram id="cs550_clean_eer" name="CS550 EER Diagram">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1100" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== HEADER BANNER ==================== -->
        <mxCell id="header" value="&lt;b style='font-size:16px;'&gt;CS 550 / CS 450: Collaborative Supply Chain EER Diagram&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#cbd5e1;'&gt;Entities, Specialization Hierarchies (ISA), Associative Pricing, and Independent Order Streams&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#1e293b;fontColor=#ffffff;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="50" as="geometry" />
        </mxCell>

        <!-- ==================== 1. BUSINESS ENTITIES HIERARCHY (LEFT) ==================== -->
        <!-- Superclass: BusinessEntities -->
        <mxCell id="be" value="&lt;b style='font-size:13px;'&gt;BusinessEntities&lt;/b&gt;&lt;hr&gt;&lt;b&gt;&lt;u&gt;entityId&lt;/u&gt;&lt;/b&gt; : VARCHAR(30) [PK]&lt;br&gt;name : VARCHAR(100)&lt;br&gt;shipLoc : VARCHAR(50)&lt;br&gt;address : VARCHAR(150)&lt;br&gt;phone : VARCHAR(20)&lt;br&gt;web : VARCHAR(100)&lt;br&gt;contactInfo : VARCHAR(100)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="240" height="150" as="geometry" />
        </mxCell>

        <!-- Disjoint ISA Circle 'd' -->
