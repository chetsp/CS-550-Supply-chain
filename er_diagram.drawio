        <mxCell id="e_shp_to_pricing" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8b5cf6;strokeWidth=1.5;strokeDasharray=4;endArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="sub_shp" target="pricing_shp" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
